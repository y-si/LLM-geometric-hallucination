\@writefile{lot}{\contentsline {table}{\numberline {6.4}{\ignorespaces Logistic regression AUC for predicting fixability (fixed vs.\ still-broken) using four geometric features, with 5-fold cross-validation. Llama achieves a cross-validated AUC of 0.712, indicating genuine predictive signal despite severe class imbalance (9:1). Mixtral's weaker 0.573 likely reflects its more extreme imbalance (12:1).}}{70}{table.caption.24}\protected@file@percent }
\newlabel{tab:fixability-auc}{{6.4}{70}{Logistic regression AUC for predicting fixability (fixed vs.\ still-broken) using four geometric features, with 5-fold cross-validation. Llama achieves a cross-validated AUC of 0.712, indicating genuine predictive signal despite severe class imbalance (9:1). Mixtral's weaker 0.573 likely reflects its more extreme imbalance (12:1)}{table.caption.24}{}}
