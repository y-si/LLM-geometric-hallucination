\newlabel{AppendixB}{{B}{102}{Supplementary Analysis}{appendix.1.B}{}}
\@writefile{toc}{\contentsline {section}{\numberline {B.1}Cross-Model Correlation Matrix}{102}{section.1.B.1}\protected@file@percent }
\newlabel{app:kendall-matrix}{{B.1}{102}{Cross-Model Correlation Matrix}{section.1.B.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {B.1}{\ignorespaces Kendall's ${"τ}$ rank correlation of per-prompt binary hallucination indicators across all 10 models on the 449-prompt initial benchmark. Mean ${"τ}= 0.319$ (SD $= 0.137$, range 0.068--0.617). Of 45 model pairs, 42 are significant at $p < 0.05$; the three non-significant pairs all involve Qwen~3~Next~80B. Same-family pairs (e.g., GPT-4.1-mini / GPT-4o-mini, ${"τ}= 0.617$) show stronger correlations than cross-family pairs.}}{103}{figure.caption.38}\protected@file@percent }
\newlabel{fig:kendall-heatmap}{{B.1}{103}{Kendall's $\tau $ rank correlation of per-prompt binary hallucination indicators across all 10 models on the 449-prompt initial benchmark. Mean $\tau = 0.319$ (SD $= 0.137$, range 0.068--0.617). Of 45 model pairs, 42 are significant at $p < 0.05$; the three non-significant pairs all involve Qwen~3~Next~80B. Same-family pairs (e.g., GPT-4.1-mini / GPT-4o-mini, $\tau = 0.617$) show stronger correlations than cross-family pairs}{figure.caption.38}{}}
\@writefile{toc}{\contentsline {section}{\numberline {B.2}Embedding Model Robustness}{104}{section.1.B.2}\protected@file@percent }
\newlabel{app:embedding-robustness}{{B.2}{104}{Embedding Model Robustness}{section.1.B.2}{}}
\@writefile{lot}{\contentsline {table}{\numberline {B.1}{\ignorespaces Spearman rank correlations between geometric features and binary hallucination indicators across three embedding models on the initial benchmark (368 prompts, four main categories). These are \emph  {overall} correlations that conflate category structure; the within-category analysis in Chapter~\ref {ch:geo-predict-hallucination} uses the expanded benchmark with category-level controls.}}{104}{table.caption.39}\protected@file@percent }
\newlabel{tab:embedding-robustness}{{B.1}{104}{Spearman rank correlations between geometric features and binary hallucination indicators across three embedding models on the initial benchmark (368 prompts, four main categories). These are \emph {overall} correlations that conflate category structure; the within-category analysis in Chapter~\ref {ch:geo-predict-hallucination} uses the expanded benchmark with category-level controls}{table.caption.39}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {B.2}{\ignorespaces Spearman correlations between geometric features and hallucination across three embedding models. Centrality shows the most stable relationship: negative correlations across all three models, significant in two of three. Density and curvature are less stable, with sign and significance varying across models.}}{105}{figure.caption.40}\protected@file@percent }
\newlabel{fig:embedding-robustness}{{B.2}{105}{Spearman correlations between geometric features and hallucination across three embedding models. Centrality shows the most stable relationship: negative correlations across all three models, significant in two of three. Density and curvature are less stable, with sign and significance varying across models}{figure.caption.40}{}}
